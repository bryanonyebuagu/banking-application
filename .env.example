# Runtime configuration contract: local | test | demo | production.
APP_ENV=local
# Required absolute app origin; used for validated auth redirects and origin checks.
APP_ORIGIN=http://localhost:3000
# Required at auth integration. Safe for browser use, protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase Auth sends verification and recovery messages. Set custom-smtp only
# after a production SMTP provider and sender domain are configured in Supabase.
AUTH_EMAIL_DELIVERY=supabase-default
# Server-only: required only for privileged setup/jobs that explicitly need it.
# Use the key type supported by the pinned Supabase SDK; never prefix NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Tooling-only migration connection; never consumed by browser code.
SUPABASE_DB_URL=
# Worker authentication, required when scheduled processing is enabled.
JOB_RUNNER_SECRET=
# External payment rails remain fail-closed until institutional onboarding is complete.
# disabled | jpmorgan-mock | jpmorgan-production
PAYMENTS_PROVIDER_MODE=disabled
JPMORGAN_PAYMENTS_BASE_URL=
JPMORGAN_OAUTH_TOKEN_URL=
JPMORGAN_CLIENT_ID=
JPMORGAN_CLIENT_SECRET=
JPMORGAN_ACCOUNT_ID=
# Comma-separated entitlements confirmed by J.P. Morgan, for example:
# ach,domestic_wire,international_wire,rtp. Zelle requires separate network approval.
JPMORGAN_ENABLED_RAILS=
# Explicit guard for local/test seed execution; never enable in a hosted environment.
ALLOW_SYNTHETIC_SEED=false
# Optional development-only demo identities. Keep real values in .env.local.
DEMO_CUSTOMER_EMAIL=
DEMO_CUSTOMER_PASSWORD=
DEMO_SECONDARY_EMAIL=
DEMO_SECONDARY_PASSWORD=
DEMO_STAFF_EMAIL=
DEMO_STAFF_PASSWORD=
