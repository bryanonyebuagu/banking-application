{
  "name": "chaze-bank",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:integration": "node scripts/run-e2e.mjs --project=chromium",
    "test:e2e:auth": "node scripts/run-auth-e2e.mjs",
    "test:db": "node scripts/supabase-podman.mjs test db",
    "db:start": "node scripts/supabase-podman.mjs start",
    "db:status": "node scripts/supabase-podman.mjs status",
    "db:reset": "node scripts/supabase-podman.mjs db reset --local",
    "db:types": "node scripts/supabase-podman.mjs gen types typescript --local --schema public",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run test:e2e",
    "db:stop": "node scripts/supabase-podman.mjs stop",
    "db:hosted:check": "node scripts/check-hosted-db.mjs",
    "db:hosted:plan": "node scripts/migrate-hosted-db.mjs plan development",
    "db:hosted:apply": "node scripts/migrate-hosted-db.mjs apply development",
    "db:test:plan": "node scripts/migrate-hosted-db.mjs plan test",
    "db:test:apply": "node scripts/migrate-hosted-db.mjs apply test",
    "db:test:parity": "node scripts/verify-hosted-schema-parity.mjs",
    "db:test:cleanup-check": "node scripts/check-test-cleanup.mjs",
    "db:types:hosted": "node scripts/generate-database-types.mjs",
    "test:db:identity-rehearsal": "node scripts/verify-identity-migration.mjs",
    "test:db:identity-api": "node scripts/test-hosted-identity-api.mjs",
    "test:db:test-identity-api": "node scripts/test-hosted-identity-api.mjs test",
    "test:db:test-storage-api": "node scripts/test-hosted-storage-api.mjs",
    "test:db:auth-session-rehearsal": "node scripts/verify-auth-session-migration.mjs",
    "test:db:session-expiration-rehearsal": "node scripts/verify-session-expiration-migration.mjs",
    "test:db:registration-rehearsal": "node scripts/verify-registration-migration.mjs",
    "test:db:account-rehearsal": "node scripts/verify-account-migration.mjs",
    "test:db:account-api": "node scripts/test-account-api.mjs",
    "test:db:ledger-posting-rehearsal": "node scripts/verify-ledger-posting-migration.mjs",
    "test:db:transaction-history-rehearsal": "node scripts/verify-transaction-history-migration.mjs",
    "test:db:transfer-rehearsal": "node scripts/verify-transfer-migration.mjs",
    "test:db:transfer-scheduling-rehearsal": "node scripts/verify-transfer-scheduling-migration.mjs",
    "test:db:bill-pay-rehearsal": "node scripts/verify-bill-pay-migration.mjs",
    "test:db:bill-pay-api": "node scripts/test-bill-pay-api.mjs",
    "test:db:credit-card-rehearsal": "node scripts/verify-credit-card-migration.mjs",
    "test:db:credit-card-api": "node scripts/test-credit-card-api.mjs",
    "test:db:credit-card-security-rehearsal": "node scripts/verify-credit-card-security-migration.mjs",
    "test:db:check-deposit-rehearsal": "node scripts/verify-check-deposit-migration.mjs",
    "test:db:check-deposit-api": "node scripts/test-check-deposit-api.mjs",
    "test:db:statement-rehearsal": "node scripts/verify-statement-migration.mjs",
    "test:db:statement-api": "node scripts/test-statement-api.mjs",
    "test:db:registration-api": "node scripts/test-registration-api.mjs",
    "test:db:auth-session-api": "node scripts/test-auth-session-api.mjs",
    "db:test:cleanup-auth-fixtures": "node scripts/test-auth-fixture-cleanup.mjs",
    "test:db:ledger-rehearsal": "node scripts/verify-ledger-migration.mjs",
    "test:db:product-rehearsal": "node scripts/verify-product-migrations.mjs",
    "seed:demo": "node scripts/seed-demo-data.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.1",
    "@tanstack/react-query": "5.103.2",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@supabase/postgrest-typegen": "0.3.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "pg": "8.23.0",
    "supabase": "2.117.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
